# Copiar a .env (ignorado por git). Lo usan server/server.js (npm start), las sondas (tests/api) y E2E_LIVE.
# Nunca escribas valores reales en otro archivo, evidencia, Issue o PR.

# --- Servidor web (FND-002, ADR-0002) ---
PORT=3000
# Backend de desarrollo: siempre por el nombre del certificado (hanoit), nunca por IP.
# La máquina del frontend resuelve hanoit en /etc/hosts: "<ip-del-backend> hanoit". Puerto 8000 abierto.
BACKEND_URL=https://hanoit:8000
# Vacío: la API no tiene gateway ni X-Api-Key; el acceso es JWT tras POST /api/v1/auth/login.
BACKEND_API_KEY=
BACKEND_TIMEOUT_MS=60000
BACKEND_PLAN_TIMEOUT_MS=180000
# Certificado PÚBLICO del servidor (autofirmado CN=hanoit), no rootCA.crt de mkcert.
# Lo cargan server/proxy.js y tests/api; ruta relativa a la raíz o absoluta (p. ej. /etc/hanoit/hanoit-dev.pem).
BACKEND_CA_FILE=config/certs/hanoit-dev.pem
# Opcional: herramientas externas (curl de Node, scripts) solo lo leen si está en el entorno al arrancar.
NODE_EXTRA_CA_CERTS=
# Ejemplo Satellizer/MongoDB heredado (se retira en CIE-001). Déjalo vacío.
LEGACY_SATELLIZER=

# --- Cuenta de pruebas (sondas API y E2E en vivo; nunca una cuenta real) ---
SDD_TEST_TENANT_ID=
SDD_TEST_EMAIL=
SDD_TEST_PASSWORD=
SDD_TEST_AGENT_EMAIL=
SDD_TEST_AGENT_PASSWORD=
SDD_TEST_DRIVER_EMAIL=
SDD_TEST_DRIVER_PASSWORD=
SDD_TEST_SUPERADMIN_EMAIL=
SDD_TEST_SUPERADMIN_PASSWORD=

# --- Pruebas ---
# E2E_LIVE=1 ejecuta Playwright contra BACKEND_URL en vez del mock; E2E_SKIP_BUILD=1 no recompila
E2E_LIVE=
E2E_SKIP_BUILD=
# CHROME_BIN= (por defecto, el Chromium de Playwright)
