# Copia este fichero a `.env` y rellena los valores reales. `.env` está ignorado por git.
# Los usa el proxy del gateway (server/gateway-proxy.js) y el proxy de desarrollo de ng-ruteando.

# Qué gateway usar: `real` (por defecto) usa GATEWAY_URL y GATEWAY_API_KEY; `mock` usa el gateway FALSO de
# scripts/mock-gateway.mjs (datos de demostración en memoria), que se arranca solo dentro del mismo proceso, tanto en
# `ng serve` como en el servidor de producción. Con `mock` no se envía la clave real. Para cambiar de modo, edita esta línea y
# reinicia. PROVISIONAL: se retira cuando los servicios reales estén estables (ver server/gateway-mode.js).
# GATEWAY_MODE=real
# Solo con mock: puerto del simulado (4010) y contraseña de sus usuarios (demo1234 por defecto). Si el servidor es accesible
# desde fuera, define MOCK_GATEWAY_PASSWORD: si no, cualquiera entra con la contraseña pública.
# MOCK_GATEWAY_PORT=4010
# MOCK_GATEWAY_PASSWORD=

# Dirección base del HanoIT Gateway, sin /api/v1 al final
GATEWAY_URL=https://gateway.example.invalid

# Clave de API del gateway (cabecera X-Api-Key). Es un secreto: nunca en el frontend ni en git.
GATEWAY_API_KEY=change-me

# Tiempo máximo de espera de una petición al gateway, en milisegundos (30000 por defecto). Súbelo si
# planificar una jornada tarda más: al agotarse el proxy responde 504 y la pantalla avisa.
# GATEWAY_TIMEOUT_MS=30000

# Solo desarrollo (`ng serve`, también con Docker): retraso artificial en milisegundos de cada petición a /gateway, para ver
# los esqueletos de carga. Vacío, 0 o ausente = apagado. El servidor de producción no lo lee. Reinicia `ng serve` al cambiarlo.
# GATEWAY_DELAY_MS=1500

# Cabeceras de seguridad (server/security-headers.js). CSP_MODE: report-only (por defecto, el navegador solo avisa en la
# consola y no bloquea nada), enforce (bloquea lo que incumpla la política) u off. No uses enforce sin haber recorrido la
# aplicación en el navegador con report-only y sin violaciones.
# CSP_MODE=report-only
# Orígenes de imagen adicionales, separados por espacios: obligatorio si cambias el proveedor de teselas (environment*.ts)
# CSP_IMG_SRC=

# Entorno de desarrollo con Docker (compose.yaml): por defecto usa el gateway SIMULADO. Descomenta para usar otro gateway.
# Son variables aparte de GATEWAY_URL/GATEWAY_API_KEY para no aplicar el gateway real por accidente.
# DOCKER_GATEWAY_URL=
# DOCKER_GATEWAY_API_KEY=

# ---------- Segundo factor (OTP por correo, OTP por SMS y TOTP; ver openspec/changes/add-mfa) ----------
# Sin MFA_SECRET_KEY el módulo queda APAGADO: el login funciona como siempre. Es un secreto (32 bytes en base64): genera uno con
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cambiarla invalida los secretos TOTP ya guardados (hay que volver a activarlos). Con Docker de desarrollo ya viene una de pruebas.
MFA_SECRET_KEY=
# Fichero SQLite con la política, los factores y los códigos de recuperación (data/ está en .gitignore). En producción necesita un
# volumen persistente, y el servidor debe ser una sola instancia (los retos viven en memoria).
MFA_DB_PATH=data/mfa.sqlite
# Solo `ng serve`: puerto local donde corre el módulo de segundo factor (por defecto 4020).
MFA_DEV_PORT=4020

# Correo (SMTP) para los códigos. En desarrollo: Mailpit del Docker (docker compose up mailpit; bandeja en http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ruteando <no-responder@ruteando.local>

# SMS: `dev` entrega el texto a Mailpit (no envía nada real); `twilio` usa Twilio Verify. Sin credenciales de Twilio
# y sin `dev`, el método SMS no se ofrece a nadie. Cómo crear el servicio Verify y sacar estos tres valores (cuenta Live, no
# Test), y qué cambiar para producción: README.md, sección «Segundo factor».
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---------- Inicio de sesión único (SSO; ver openspec/changes/add-sso y README.md, «Inicio de sesión único») ----------
# Apagado por defecto. Necesita también MFA_SECRET_KEY (cifra el secreto del proveedor de cada empresa).
# Lista separada por comas: google, github, apple, enterprise
SSO_ENABLED_PROVIDERS=
# Dirección pública de la aplicación, sin barra final (en `ng serve`: http://localhost:4200). Se registra en cada proveedor como
# <esta dirección>/gateway/sso/<proveedor>/callback
SSO_REDIRECT_BASE_URL=
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_CLIENT_SECRET=
SSO_APPLE_CLIENT_ID=
SSO_APPLE_TEAM_ID=
SSO_APPLE_KEY_ID=
# Clave privada (.p8) en una sola línea, con 
 en lugar de saltos de línea
SSO_APPLE_PRIVATE_KEY=
# Identidades enlazadas y proveedor de cada empresa (data/ está en .gitignore). En producción, un volumen persistente.
SSO_DB_PATH=data/sso.sqlite
# SOLO desarrollo con scripts/mock-oidc-provider.cjs: admite emisores http y sin filtro de red interna. No lo actives en producción.
# SSO_ALLOW_INSECURE=true
# SSO_GOOGLE_ISSUER=http://127.0.0.1:4030
