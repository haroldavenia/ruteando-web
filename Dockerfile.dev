# Imagen de DESARROLLO (no es la de producción). El código se monta desde el equipo y las dependencias viven en volúmenes
# (ver compose.yaml), así que la imagen solo trae Node.
FROM node:22-bookworm-slim AS dev
WORKDIR /app
ENV NG_CLI_ANALYTICS=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false
# El Node de la imagen puede traer un npm que falla al instalar desde cero (ver CLAUDE.md, integración continua)
RUN npm install -g npm@11

# Pruebas del frontend: Karma necesita un Chrome. Chromium de Debian; los flags sin interfaz y sin sandbox ya están en karma.conf.js
FROM dev AS test
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium \
    && rm -rf /var/lib/apt/lists/*
ENV CHROME_BIN=/usr/bin/chromium
