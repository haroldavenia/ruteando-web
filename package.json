{
  "name": "ruteando-web",
  "private": true,
  "version": "0.0.0",
  "description": "Ruteando: aplicación web de planificación de rutas (Next.js BFF en next-ruteando/) sobre el HanoIT Gateway",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "pnpm --filter next-ruteando run build",
    "test": "pnpm --filter next-ruteando run test",
    "mock:gateway": "node scripts/mock-gateway.mjs",
    "docker:dev": "docker compose up",
    "docker:test": "docker compose --profile test run --rm test",
    "docker:down": "docker compose down",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
