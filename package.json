{
  "name": "ruteando-web",
  "private": true,
  "version": "0.0.0",
  "description": "Ruteando web (AngularJS 1.3) migrado a /api/v1 con arnés SDD",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "angular": "1.3.15",
    "angular-mocks": "1.3.15",
    "async": "^0.9.2",
    "bcryptjs": "^2.1.0",
    "body-parser": "^1.20.0",
    "colors": "^1.1.0",
    "cors": "^2.7.1",
    "cross-env": "^10.1.0",
    "express": "^4.18.1",
    "faker": "^3.0.1",
    "http-server": "^14.1.1",
    "jwt-simple": "^0.5.6",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-junit-reporter": "^2.0.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "mongoose": "^6.5.3",
    "morgan": "^1.10.0",
    "multer": "^0.1.8",
    "request": "^2.55.0",
    "shelljs": "^0.8.5"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.js",
    "build": "cd master && npx gulp build",
    "test": "node --test \"tools/test/*.test.mjs\" \"tests/tools/*.test.mjs\"",
    "test:unit": "karma start karma.conf.cjs --single-run",
    "test:integration": "cross-env SUITE=integration karma start karma.conf.cjs --single-run",
    "test:server": "node --test \"tests/server/*.test.mjs\"",
    "test:e2e": "node tests/e2e/ensure-build.mjs && playwright test",
    "test:api": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\" && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit-api.xml \"tests/api/*.api.test.mjs\"",
    "test:all": "npm test && npm run test:unit && npm run test:integration && npm run test:server",
    "coverage": "npm run coverage:tools",
    "coverage:tools": "node -e \"require('fs').mkdirSync('coverage/tools',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-include=\"tools/*.mjs\" --test-coverage-include=\"master/gulp-node-compat.cjs\" --test-coverage-lines=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/tools/lcov.info \"tools/test/*.test.mjs\" \"tests/tools/gulp-node-compat.test.mjs\"",
    "coverage:unit": "cross-env COVERAGE=1 karma start karma.conf.cjs --single-run",
    "coverage:server": "node -e \"require('fs').mkdirSync('coverage/server',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-include=\"server/app.js\" --test-coverage-include=\"server/proxy.js\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/server/lcov.info \"tests/server/*.test.mjs\"",
    "coverage:diff": "node tools/diff-coverage.mjs --lcov coverage/lcov.info --threshold 90 --include \"^((master/js|server|tools)/.*|master/[^/]+)\\.(c|m)?js$\" --exclude \"(^|/)(node_modules|bower_components|tests?|coverage)/|\\.(test|spec)\\.(c|m)?js$|^server/legacy-satellizer\\.js$|^master/gulpfile\\.js$\"",
    "coverage:merge": "node tools/merge-lcov.mjs coverage/lcov.info coverage/unit/lcov.info coverage/server/lcov.info coverage/tools/lcov.info",
    "mock-api": "node tests/mock-api/server.mjs",
    "specs": "node tools/specs.mjs",
    "validate": "node tools/validate-harness.mjs ."
  },
  "dependencies": {
    "@ng-bootstrap/ng-bootstrap": "^18.0.0",
    "bufferutil": "^4.0.7"
  },
  "engines": {
    "node": "^24"
  }
}
