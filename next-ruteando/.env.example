# Servidor (BFF). Copia a .env.local; nunca se versiona.
# real (por defecto) o mock: el gateway simulado de ../scripts/mock-gateway.mjs (puerto MOCK_GATEWAY_PORT, 4010)
GATEWAY_MODE=real
GATEWAY_URL=
# Secreto: solo vive en el servidor
GATEWAY_API_KEY=
GATEWAY_TIMEOUT_MS=30000
# Firma la cookie rt_user (openssl rand -base64 32). En producción es obligatoria (mínimo 32 caracteres): sin ella el servidor no arranca
SESSION_SECRET=
# Las cookies son Secure en producción; en local con http:// pon false
COOKIE_SECURE=
# report-only (por defecto), enforce u off
CSP_MODE=report-only
# Mientras no exista el segundo factor (fase 3) el login falla cerrado; true solo en desarrollo o con el simulado
ALLOW_LOGIN_WITHOUT_MFA=
# Proxys de confianza delante (para la IP del cliente en X-Forwarded-For); 0 = no confiar en la cabecera
TRUSTED_PROXY_HOPS=1

# Segundo factor (2FA). Sin MFA_SECRET_KEY queda apagado y el login solo abre con ALLOW_LOGIN_WITHOUT_MFA=true
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  (cambiarla invalida los secretos TOTP guardados)
MFA_SECRET_KEY=
# Almacén SQLite del 2FA: necesita un volumen persistente en producción
MFA_DB_PATH=data/mfa.sqlite
# Correo (códigos por correo); en local, Mailpit en 127.0.0.1:1025
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMS: twilio o dev (el SMS llega como correo a Mailpit)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Inicio de sesión único (SSO): google, github, apple, enterprise. Apagado sin SSO_ENABLED_PROVIDERS, SSO_REDIRECT_BASE_URL y MFA_SECRET_KEY
SSO_ENABLED_PROVIDERS=
# Dirección pública de la aplicación, sin barra final. Se registra <base>/gateway/sso/<proveedor>/callback en cada proveedor
SSO_REDIRECT_BASE_URL=
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_CLIENT_SECRET=
SSO_APPLE_CLIENT_ID=
SSO_APPLE_TEAM_ID=
SSO_APPLE_KEY_ID=
SSO_APPLE_PRIVATE_KEY=
# Almacén SQLite de identidades y proveedores de empresa: necesita un volumen persistente en producción
SSO_DB_PATH=data/sso.sqlite
# SOLO desarrollo (proveedor simulado en http): nunca en producción
SSO_ALLOW_INSECURE=
