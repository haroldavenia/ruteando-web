{
  "name": "POST /api/v1/auth/reset-password",
  "request": {
    "method": "POST",
    "url": "/api/v1/auth/reset-password",
    "body": {
      "token": "{verification_token}",
      "newPassword": "contraseña-ficticia"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "message": "Contraseña actualizada exitosamente."
    }
  }
}
